#!/bin/bash
# First-boot provisioning. Runs once. Output: /var/log/cloud-init-output.log
set -euxo pipefail
export DEBIAN_FRONTEND=noninteractive

apt-get update -y
apt-get install -y nginx certbot python3-certbot-nginx unzip curl ca-certificates

# Node.js 22 LTS
curl -fsSL https://deb.nodesource.com/setup_22.x | bash -
apt-get install -y nodejs

# AWS CLI v2
curl -fsSL https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip -o /tmp/awscliv2.zip
unzip -q /tmp/awscliv2.zip -d /tmp
/tmp/aws/install
rm -rf /tmp/aws /tmp/awscliv2.zip

mkdir -p /etc/app /opt/app/releases

# Config read by the deploy script
cat > /etc/app/config.env <<'CONF'
AWS_REGION=${region}
API_DOMAIN=${api_domain}
CERTBOT_EMAIL=${certbot_email}
DB_URL_PARAM=${db_url_param}
CORS_ORIGIN=${cors_origin}
CONF
chmod 644 /etc/app/config.env

# Deploy script (invoked by GitHub Actions through SSM Run Command)
cat > /usr/local/bin/deploy-api <<'DEPLOY'
${deploy_script}
DEPLOY
chmod 750 /usr/local/bin/deploy-api

# systemd service for the Fastify API
cat > /etc/systemd/system/app-api.service <<'UNIT'
[Unit]
Description=Fastify API
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/app/current
EnvironmentFile=/etc/app/app.env
ExecStart=/usr/bin/node dist/server.js
Restart=always
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload
systemctl enable app-api

# Nginx reverse proxy (certbot adds HTTPS on the first deploy)
rm -f /etc/nginx/sites-enabled/default
cat > /etc/nginx/sites-available/api <<'NGINX'
server {
    listen 80;
    server_name ${api_domain};
    client_max_body_size 10m;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
NGINX
ln -sf /etc/nginx/sites-available/api /etc/nginx/sites-enabled/api
nginx -t
systemctl enable nginx
systemctl restart nginx
